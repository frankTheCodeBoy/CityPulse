# Backend Environment Variables
# Copy this to .env.production and fill in your values

# Database URL (PostgreSQL from Neon or Render)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech:5432/citypulse

# Application Environment
ENVIRONMENT=production

# Frontend URL (for CORS)
FRONTEND_URL=https://citypulse.vercel.app

# Port (Render uses PORT, defaults to 10000)
PORT=10000

# Frontend Environment Variables (.env.production in frontend/)
# REACT_APP_API_URL=https://citypulse-backend.onrender.com
